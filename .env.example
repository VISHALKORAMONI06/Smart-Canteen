# SmartCanteen — Environment Variables
# Copy this file to .env and fill in your Supabase project credentials.
# NEVER commit .env to version control.

# -----------------------------------------------------------------------
# Supabase Project URL
# Found in: Supabase Dashboard → Project Settings → API → Project URL
# -----------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# -----------------------------------------------------------------------
# Supabase Anon / Publishable Key
# Found in: Supabase Dashboard → Project Settings → API → anon public key
# This key is safe to use in browser code — Row-Level Security enforces access.
# NEVER use the service_role key in frontend code.
# -----------------------------------------------------------------------
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...your_anon_key_here

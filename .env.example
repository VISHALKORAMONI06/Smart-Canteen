# SmartCanteen — Environment Variables
# Copy this file to .env and fill in your credentials.
# NEVER commit .env to version control.

# -----------------------------------------------------------------------
# Supabase Project (Frontend — safe in browser)
# Found in: Supabase Dashboard → Project Settings → API
# -----------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...your_anon_key_here

# -----------------------------------------------------------------------
# Edge Function Secrets (set via: supabase secrets set NAME=value)
# These are SERVER-SIDE only — never expose in frontend code.
# -----------------------------------------------------------------------

# Razorpay — https://dashboard.razorpay.com/app/keys
# key_id is public (returned to frontend), key_secret MUST stay server-side only.
RAZORPAY_KEY_ID=rzp_test_...your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# Razorpay Webhook Secret — configure in Razorpay Dashboard → Webhooks
# Used by razorpay-webhook edge function to verify event authenticity.
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# Resend Email — https://resend.com/api-keys
# Used by send-order-email edge function to dispatch transactional emails.
RESEND_API_KEY=re_...your_resend_api_key_here
RESEND_FROM_EMAIL=SmartCanteen <noreply@yourdomain.com>

# Supabase Service Role (Edge Functions only — NEVER in frontend)
# Found in: Supabase Dashboard → Project Settings → API → service_role key
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...your_service_role_key_here

# -----------------------------------------------------------------------
# How to set Edge Function secrets (run once per secret):
#
#   supabase secrets set RAZORPAY_KEY_ID=rzp_test_xxx
#   supabase secrets set RAZORPAY_KEY_SECRET=xxx
#   supabase secrets set RAZORPAY_WEBHOOK_SECRET=xxx
#   supabase secrets set RESEND_API_KEY=re_xxx
#   supabase secrets set RESEND_FROM_EMAIL="SmartCanteen <noreply@yourdomain.com>"
#   supabase secrets set SUPABASE_SERVICE_ROLE_KEY=eyJ...
#
# To verify what's set:
#   supabase secrets list
# -----------------------------------------------------------------------
